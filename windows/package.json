{
  "name": "pronostici-calcio",
  "productName": "Pronostici Calcio",
  "version": "1.0.0",
  "description": "Pronostici Calcio Europa per Windows: apre la pagina aggiornata ogni volta.",
  "main": "main.js",
  "author": "Alessandro Dalla Cort",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.pronostici.calcio",
    "productName": "Pronostici Calcio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pronostici Calcio",
      "artifactName": "PronosticiCalcio-Installa.${ext}"
    },
    "portable": { "artifactName": "PronosticiCalcio-Portatile.${ext}" }
  }
}
